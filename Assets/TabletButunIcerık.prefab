      m_Calls: []
  m_text: "A\u011F\u0131r Hasar: Ta\u015F\u0131y\u0131c\u0131 sistemde (kolon ve
    kiri\u015Flerde) geni\u015Fli\u011Fi 2mm'den b\xFCy\xFCk 'X' tipi \xE7atlaklar
    mevcuttur. Donat\u0131 korozyona u\u011Fram\u0131\u015F veya beton ezilmi\u015Ftir.
    Bina g\xF6\xE7me riski alt\u0131ndad\u0131r, kesinlikle girilemez."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
